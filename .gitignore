# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Node modules & dependencies
node_modules/
dist/
dist-ssr/
build/
*.local

# Environment variables & secrets (exclude all variants, keep example templates)
.env
.env.*
*.env
!.env.example
!*.env.example

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS metadata & temporary files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Uploaded files & CSV datasets (preserve directory structure via .gitkeep)
*.csv
uploads/*
!uploads/.gitkeep
server/uploads/*
!server/uploads/.gitkeep

# Python & ML Service Artifacts
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
ml_service/artifacts/*
!ml_service/artifacts/.gitkeep
