# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Node modules
node_modules/
*.local

# Environment variables & secrets (exclude all variants, keep example templates)
.env
.env.*
*.env
!.env.example
!*.env.example

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea/

# OS metadata & temporary files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Uploaded files (keep upload folder tracked via .gitkeep)
uploads/*
!uploads/.gitkeep
