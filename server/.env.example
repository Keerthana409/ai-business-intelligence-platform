# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String
# For local MongoDB: mongodb://localhost:27017/retail_bi_db
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/retail_bi_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/retail_bi_db

# JWT Authentication Secret & Expiration
JWT_SECRET=replace_with_a_secure_random_secret_key_at_least_32_chars
JWT_EXPIRES_IN=7d

# CORS Allowed Origin (Client URL)
CLIENT_URL=http://localhost:5173

# Python FastAPI ML Service Configuration
ML_SERVICE_URL=http://127.0.0.1:8000
ML_SERVICE_TIMEOUT_MS=4000
